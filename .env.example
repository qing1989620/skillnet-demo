# 复制本文件为 .env，然后填入你自己的 DeepSeek API 密钥。
#
# 密钥可以留空 —— 以下功能不依赖大模型，开箱即可使用：
#   技能库浏览、三档检索对照、技能关系图、实验结果面板、跨框架导出
#
# 填入密钥后才能使用：
#   Fabric 任务级路由与依赖编排、技能驱动的 Agent 执行与盲评、
#   技能蒸馏 / 变异 / 交叉 / 再生成、一键全链路演示
#
# 密钥获取地址：https://platform.deepseek.com

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 本机演示可留空；监听内网/公网地址时必须设置服务间访问令牌。
# 浏览器顶部「连接设置」或 API 的 X-SkillNet-Token / Bearer 使用同一令牌。
SKILLNET_TOKEN=

# 单进程后台任务并发上限，合法范围 1–32。
SKILLNET_MAX_ACTIVE_RUNS=4
