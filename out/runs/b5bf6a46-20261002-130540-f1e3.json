 "plan": {
  "approach": "以剂量-响应数据为对象，先做带审计轨迹的清洗与单位统一，再用 EDA 判断平台期覆盖与模型形式，随后用 4PL/3PL 非线性最小二乘拟合 IC50 并做 bootstrap 与残差诊断，最后用稳健性审计与出版级矢量图交付可复现结论。",
  "steps": [
   {
    "skill": "data-cleaning",
    "action": "读取原始剂量-响应表，统一剂量单位为 μM 或 log10(μM)、抑制率为 0-1 小数，检查主键唯一性、重复孔、缺失与异常点，异常点标记而非删除，输出干净数据表与审计日志。",
    "key_params": [
     "剂量单位统一为 μM 或 log10(μM)，避免跨数量级拟合偏差",
     "抑制率统一为 0-1 小数，防止 Top/Bottom 解释错误",
     "异常点按业务规则标记，不静默删除，保留审计轨迹",
     "缺失模式区分随机与非随机，非随机缺失不做均值填补"
    ],
    "expected_output": "干净数据集（dose、response、replicate、group）、清洗审计日志、数据字典",
    "check": "清洗后主键唯一；审计日志可复现每一步；关键字段分布变化有解释；剂量-响应散点无系统性单位错位"
   },
   {
    "skill": "eda-profiling",
    "action": "按剂量分组计算均值、SD、n，检查最低剂量抑制率是否接近 0、最高剂量是否接近 100%，判断 Bottom/Top 是否需固定，标记 n<3 的低置信剂量点，输出分布与分组对比图。",
    "key_params": [
     "最低剂量抑制率接近 0 则考虑固定 Bottom=0",
     "最高剂量抑制率接近 100% 则考虑固定 Top=100",
     "n<3 的剂量点标记为低置信",
     "确认 log10(dose) 与 dose 不同时进入同一模型"
    ],
    "expected_output": "EDA 报告、剂量-响应散点图、候选模型形式建议",
    "check": "分布图覆盖全部剂量点；组间样本量差异已标注；曲线形态支持所选模型形式"
   },
   {
    "skill": "dose-response-ic50-estimation",
