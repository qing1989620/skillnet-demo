 "plan": {
  "approach": "以「清洗—探查—拟合—稳健性审计—可视化」为主线，把原始剂量-存活率表逐步转化为带审计轨迹的干净数据、4PL/3PL 拟合的 IC50 点估计与区间估计，并通过 bootstrap 与蒙特卡洛稳健性审计验证结论在有限样本与假设违反下是否成立，最终交付可复现的矢量图与统计报告。每一步都设置可核验的判据，异常点只标记不删除，重采样单位严格按独立实验批次而非孔。",
  "steps": [
   {
    "skill": "data-cleaning",
    "action": "读取原始剂量-响应表，统一剂量单位为 μM 并生成 log10(dose)，统一抑制率为 0-1 小数；检查主键 dose×replicate×group 唯一性、缺失模式与重复孔；按业务规则（载体对照均值±3SD、重复孔 CV>15%）标记异常点而非删除，输出干净数据表与逐步审计日志。",
    "key_params": [
     "剂量单位统一为 μM，理由：跨数量级单位不统一会导致拟合偏差与参数不可解释",
     "抑制率统一为 0-1 小数，理由：0-100% 与 0-1 混用会使 Top/Bottom 解释错误",
     "异常点阈值：载体对照均值±3SD、重复孔 CV>15%，理由：业务规则优先于纯统计阈值，避免选择偏差",
     "缺失处理：记录缺失模式并标注随机/非随机，不直接删除行"
    ],
    "expected_output": "干净数据表（含 log10_dose 列）、数据字典、逐步清洗审计日志（记录每步影响行数与前后分布）",
    "check": "清洗后主键唯一；审计日志可复现每一步；剂量-响应散点无系统性单位错位；关键字段分布变化有解释"
   },
   {
    "skill": "eda-profiling",
    "action": "按剂量分组计算均值、SD、n，绘制剂量-响应散点与分组分布；判断平台期覆盖（最低剂量抑制率≤5% 且最高剂量≥95%）；标注 n<3 的低置信剂量点与组间样本量差异；计算相关矩阵并标注 |r|>0.8 的共线性特征对。",
    "key_params": [
     "平台期判据：最低剂量抑制率≤5% 且最高剂量≥95%，理由：未覆盖平台期会导致 Top/Bottom 不可识别、IC50 外推不可靠",
     "低置信阈值：n<3 标注，理由：小样本剂量点参数估计不稳定",
     "共线性阈值：|r|>0.8 标注，理由：log10(dose) 与 dose 共存会造成共线性"
    ],
    "expected_output": "EDA 报告、剂量-响应散点与分组分布图、候选特征清单与风险项",
    "check": "分布图覆盖全部剂量点；组间样本量差异已标注；曲线形态支持所选模型形式；共线性项已标注"
   },
   {
    "skill": "dose-response-ic50-estimation",
    "action": "用非线性最小二乘拟合 4PL：y = Bottom + (Top-Bottom)/(1+10^((logIC50-x)*HillSlope))；初始值 Bottom=min(y)、Top=max(y)、logIC50=median(log10(dose))、HillSlope=1；若 Bottom 固定 0 或 Top 固定 100 则拟合 3PL 并用 F 检验比较嵌套模型；对 IC50 做 bootstrap（重复≥10000，重采样单位=独立实验批次/孔，固定随机种子并写入日志），在 n∈{10,100,1000,10000} 做收敛检查；做残差诊断。",
    "key_params": [
     "4PL 初始值：Bottom=min(y)、Top=max(y)、logIC50=median(log10(dose))、HillSlope=1，理由：保证非线性最小二乘收敛到合理解",
     "嵌套模型比较：F 检验，α=0.05，多命题用 Bonferroni α'=0.05/k，理由：避免多重比较假阳性",
     "bootstrap 重复次数≥10000，重采样单位=独立实验批次/孔，固定随机种子，理由：按孔重采样会导致 CI 过窄",
     "收敛检查样本量梯度 n∈{10,100,1000,10000}，理由：覆盖小样本到渐近区以观察收敛速率"
    ],
    "expected_output": "IC50 估计表（点估计、95% CI、HillSlope、Top/Bottom、R²、残差标准误）、bootstrap 不确定性与收敛曲线、残差诊断图",
    "check": "参数收敛且标准误有限；残差无系统趋势；bootstrap 收敛曲线斜率与理论 O(n^{-1/2}) 在置信带内一致；更换种子后结论方向不变；嵌套模型比较 p 值经校正后报告"
   },
   {
    "skill": "estimator-robustness-audit",
    "action": "对 IC50 估计量做稳健性审计：核验独立性、矩条件、分布支撑等前提；预注册蒙特卡洛协议（重复≥10000，α=0.05 双侧，每个命题独立随机流）；执行泄漏审计（种子记录、样本流分配、参数预注册）与反例边界审计（HillSlope→0、HillSlope 极大、Bottom/Top 不可识别、含/不含异常点对比）；报告 profile likelihood CI。",
    "key_params": [
     "蒙特卡洛重复≥10000，α=0.05 双侧，多命题 Bonferroni α'=0.05/k，理由：控制假阳性并保证数值稳定",
     "每个命题独立随机流，禁止复用样本，理由：防止伪验证",
     "反例边界：HillSlope→0、HillSlope 极大、Bottom/Top 不可识别、含/不含异常点，理由：检验前提不可省略性",
     "CI 报告方式：profile likelihood CI 为主，Wald CI 为辅，理由：HillSlope 接近 0 或极大时 Wald CI 爆炸"
    ],
    "expected_output": "公理化前提核验表、预注册蒙特卡洛协议与收敛曲线、泄漏审计报告、反例清单与适用范围表、profile likelihood CI",
    "check": "每个命题前提可追溯到已声明公理；样本流与命题一一对应无重叠；反例确实满足前提但违反结论；更换种子重跑后结论方向不变"
   },
   {
    "skill": "scientific-visualization",
    "action": "绘制出版级剂量-响应图：x 轴 log10(dose)，y 轴抑制率，散点+拟合曲线+95% 置信带，误差条为 SD 或 SEM，标注 IC50 与置信区间、HillSlope、样本量 n；导出 PDF/SVG 矢量格式并保留绘图脚本与图注。",
    "key_params": [
     "字体≥7 pt，理由：出版级可读性要求",
     "配色用 Okabe-Ito 色觉障碍友好方案，理由：满足无障碍与出版规范",
     "导出格式 PDF/SVG 矢量，理由：保证缩放不失真",
     "误差条为 SD 或 SEM，标注样本量 n，理由：完整呈现不确定性与样本量"
    ],
    "expected_output": "出版级剂量-响应曲线矢量图（PDF/SVG）、绘图脚本与图注",
    "check": "坐标轴与单位标注完整；误差条与样本量齐备；图为矢量且字号达标；IC50 标注与统计结果一致"
   }
  ],
