# 以下导出目录是随时可重新生成的，不入库。
out/adapters/
out/verify_seed/
out/verify_adapters/
out/shots/
out/tmp/
out/_last_llm_raw.txt
out/_js_check.js

# ---- 文献正文提取 ----
# 这里是 arXiv 论文的全文文本提取，不随仓库重新分发；
# 论文编号已在 README 与 docs/ 中引用，可自行获取原文。
_refs/

