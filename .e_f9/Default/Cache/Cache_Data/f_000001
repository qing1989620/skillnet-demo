<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
<title>SkillNet · 运行中心</title>
<style>
  :root{
    /* 浅色方案（沿用既有视觉语言：暖白底 + 深墨蓝主色 + 语义状态色）
       —— 上一版误用了深色，与产品一贯的"精致克制"不符，已回退。 */
    --bg:#fbfaf8; --panel:#ffffff; --panel2:#f4f6f8; --line:#e3e8ee;
    --ink:#22303e; --ink2:#5b6b7c; --ink3:#8a97a4;
    --ok:#2e7d4f; --warn:#b0781a; --bad:#a8433a; --info:#1f5f9e;
    --mono:"Cascadia Mono",Consolas,"Courier New",monospace;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  body{background:var(--bg);color:var(--ink);font:13px/1.65 "Microsoft YaHei","PingFang SC",sans-serif}
  a{color:var(--info);text-decoration:none} a:hover{text-decoration:underline}
  code{font:11.5px var(--mono);background:#eef2f6;color:#1a3a5c;padding:1px 5px;border-radius:3px}

  /* ---------- Top bar ---------- */
  header{position:sticky;top:0;z-index:20;background:rgba(251,250,248,.94);backdrop-filter:blur(6px);border-bottom:1px solid var(--line)}
  .hb{max-width:1180px;margin:0 auto;padding:11px 22px;display:flex;align-items:center;gap:20px}
  .logo{font-weight:700;font-size:15px;letter-spacing:.3px}
  .tag{font-size:11.5px;color:var(--ink3);border-left:1px solid var(--line);padding-left:12px}
  nav{margin-left:auto;display:flex;gap:3px}
  nav a{font-size:12.5px;color:var(--ink2);padding:6px 11px;border-radius:3px}
  nav a:hover{background:var(--panel2);color:var(--ink);text-decoration:none}
  nav a.on{background:var(--panel2);color:var(--ink);font-weight:600}
  .sys{display:flex;gap:14px;font:11.5px var(--mono);color:var(--ink3);align-items:center}
  .dot{width:7px;height:7px;border-radius:50%;background:var(--ink3);display:inline-block;margin-right:5px;vertical-align:1px}
  .dot.on{background:var(--ok)} .dot.off{background:var(--bad)}

  main{max-width:1180px;margin:0 auto;padding:26px 22px 60px}
  .view{display:none} .view.on{display:block}

  /* ---------- Hero ---------- */
  .hero{background:var(--panel);border:1px solid var(--line);border-radius:6px;padding:22px}
  .hero h1{font-size:19px;font-weight:700;margin-bottom:5px}
  .hero p{color:var(--ink2);font-size:12.5px;margin-bottom:16px}
  .inrow{display:flex;gap:9px}
  textarea{flex:1;min-height:74px;resize:vertical;background:var(--bg);border:1px solid var(--line);
           border-radius:4px;color:var(--ink);font:13px/1.6 inherit;padding:11px 13px}
  textarea:focus{outline:none;border-color:var(--info)}
  .btn{background:var(--info);color:#fff;border:none;border-radius:4px;font:600 13px inherit;
       padding:11px 20px;cursor:pointer;white-space:nowrap}
  .btn:hover{background:#175089} .btn:disabled{opacity:.5;cursor:not-allowed}
  .btn.ghost{background:transparent;color:var(--ink2);border:1px solid var(--line)}
  .btn.ghost:hover{color:var(--ink);border-color:var(--ink3)}
  .examples{display:flex;flex-wrap:wrap;gap:7px;margin-top:12px}
  .ex{font-size:12px;color:var(--ink2);background:var(--panel2);border:1px solid var(--line);
      border-radius:999px;padding:4px 12px;cursor:pointer}
  .ex:hover{border-color:var(--info);color:var(--ink)}
  .opts{display:flex;gap:16px;align-items:center;margin-top:12px;font:11.5px var(--mono);color:var(--ink3);flex-wrap:wrap}
  .opts input{background:var(--bg);border:1px solid var(--line);color:var(--ink);border-radius:3px;
              padding:4px 7px;font:11.5px var(--mono);width:82px}

  /* ---------- Live/Latest Run 卡 ---------- */
  .runhead{display:flex;align-items:center;gap:12px;flex-wrap:wrap}
  .badge{font:600 10.5px/1 var(--mono);letter-spacing:.4px;padding:5px 9px;border-radius:3px;border:1px solid currentColor}
  .st-COMPLETED{color:var(--ok)} .st-PARTIAL{color:var(--warn)} .st-FAILED{color:var(--bad)}
  .st-RUNNING,.st-EXECUTING,.st-RETRIEVING,.st-ORCHESTRATING,.st-VERIFYING,.st-EVOLVING{color:var(--info)}
  .st-CANCELLED,.st-INTERRUPTED,.st-CREATED{color:var(--ink3)} .st-BUDGET_EXCEEDED{color:var(--warn)}
  .steps{display:grid;gap:6px;margin-top:14px}
  .srow{display:grid;grid-template-columns:14px 1fr auto auto;gap:11px;align-items:center;
        font:12px/1.6 var(--mono);color:var(--ink2);padding:3px 0}
  .srow .nm{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--ink)}
  .sdot{width:9px;height:9px;border-radius:50%;background:var(--ink3)}
  .s-running .sdot{background:var(--info);animation:pulse 1.1s infinite}
  .s-done .sdot{background:var(--ok)} .s-failed .sdot{background:var(--bad)} .s-skipped .sdot{background:#3a4351}
  @keyframes pulse{0%,100%{box-shadow:0 0 0 0 rgba(31,95,158,.35)}55%{box-shadow:0 0 0 6px rgba(31,95,158,0)}}
  .bar{height:4px;background:var(--panel2);border-radius:2px;overflow:hidden;margin-top:12px}
  .bar i{display:block;height:100%;background:var(--info);transition:width .4s}

  /* ---------- 通用块 ---------- */
  section.card{background:var(--panel);border:1px solid var(--line);border-radius:6px;padding:18px;margin-top:16px}
  .ch{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:12px}
  .ch h2{font-size:14px;font-weight:700}
  .ch .m{font:11.5px var(--mono);color:var(--ink3)}
  table{width:100%;border-collapse:collapse;font:12px/1.7 var(--mono)}
  th{text-align:left;color:var(--ink3);font-weight:600;border-bottom:1px solid var(--line);padding:6px 8px;font-size:11px;letter-spacing:.3px}
  td{border-bottom:1px solid var(--line);padding:7px 8px;color:var(--ink2);vertical-align:top}
  tr:hover td{background:var(--panel2)}
  .three{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:16px}
  .v3{background:var(--panel);border:1px solid var(--line);border-left:2px solid var(--info);padding:15px}
  .v3 b{display:block;font-size:13px;margin-bottom:5px}
  .v3 span{color:var(--ink2);font-size:12px}
  .empty{color:var(--ink3);font-size:12.5px;padding:10px 0}
  .grid2{display:grid;grid-template-columns:1fr 1fr;gap:16px}
  @media(max-width:860px){
    /* 移动端（390×844）单独设计，不是把桌面压扁：
       - 禁止水平溢出（实测导航/按钮/chips 会被裁）
       - 需要横向滚动的地方（导航条）显式声明
       - 所有文本容器允许换行/截断 */
    html,body{overflow-x:hidden;max-width:100vw}
    .hb{flex-wrap:wrap;gap:8px;padding:10px 14px}
    .tag{display:none}
    nav{width:100%;margin-left:0;overflow-x:auto;white-space:nowrap;padding-bottom:2px}
    nav a{flex:0 0 auto}
    .sys{width:100%;flex-wrap:wrap;gap:10px}
    main{padding:14px 14px 50px;max-width:100vw}
    .hero,section.card{padding:15px;overflow:hidden}
    .hero h1{font-size:16.5px}
    .three,.grid2{grid-template-columns:1fr}
    .inrow{flex-direction:column}
    .btn{width:100%}
    textarea{width:100%}
    .ex{max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
    .opts{gap:10px}
    .opts input{width:64px}
    .srow{grid-template-columns:14px 1fr auto}
    table{display:block;overflow-x:auto;white-space:nowrap}
    .ch{flex-wrap:wrap;gap:6px}
  }
</style>
</head>
<body>
<header>
  <div class="hb">
    <span class="logo">SkillNet</span>
    <span class="tag">运行中心 · 每次运行都是一条可追溯的记录</span>
    <nav id="nav"></nav>
    <span class="sys" id="sys"></span>
  </div>
</header>

<main>
  <!-- ============ Mission Control ============ -->
  <section class="view" id="v-intro">
    <div class="hero" style="display:flex;justify-content:space-between;align-items:center">
      <div><h1 style="font-size:17px">运行中心</h1>
      <p style="margin:2px 0 0">每次运行独立 Run ID，步骤 / 产物 / 验收 / 成本全程留痕；点击行进入运行回放。</p></div>
      <a class="btn" href="/">← 回到产品首页</a>
    </div>

    <section class="card" id="latest" style="display:none">
      <div class="ch">
        <h2 id="latest-title">Latest run</h2>
        <span class="m" id="latest-meta"></span>
      </div>
      <div id="latest-body"></div>
    </section>

    <div class="three">
      <div class="v3"><b>技能感知执行</b><span>技能不是提示词：它的步骤、已知陷阱、验收清单会直接约束代码生成与失败修复。</span></div>
      <div class="v3"><b>证据化验收</b><span>产物先过确定性检查（文件/表头/行数/数值范围），语义复核只作最后一层且明确标注局限。</span></div>
      <div class="v3"><b>学习闭环</b><span>每次执行的成败写入技能账本；轨迹可蒸馏为新技能，但未经对比证明提升不会自动转正。</span></div>
    </div>
  </section>

  <!-- ============ Runs ============ -->
  <section class="view" id="v-runs">
    <section class="card">
      <div class="ch"><h2>运行记录</h2><span class="m" id="runs-meta"></span></div>
      <div id="runs-body"><div class="empty">加载中…</div></div>
    </section>
  </section>

  <!-- ============ Skills ============ -->
  <section class="view" id="v-skills">
    <section class="card">
      <div class="ch"><h2>技能库</h2><span class="m" id="skills-meta"></span></div>
      <input id="q" placeholder="搜索技能名 / 领域 / 能力…" style="width:100%;background:var(--bg);border:1px solid var(--line);border-radius:4px;color:var(--ink);padding:9px 11px;font:12.5px inherit;margin-bottom:12px">
      <div id="skills-body"><div class="empty">加载中…</div></div>
    </section>
  </section>

  <!-- ============ Evaluations ============ -->
  <section class="view" id="v-eval">
    <section class="card">
      <div class="ch"><h2>评估与实验</h2><span class="m">dev / held-out 分离，最终结论只引 held-out</span></div>
      <div id="eval-body"><div class="empty">加载中…</div></div>
    </section>
  </section>

  <!-- ============ System ============ -->
  <section class="view" id="v-system">
    <section class="card">
      <div class="ch"><h2>系统状态</h2><span class="m" id="sys-meta"></span></div>
      <div id="sys-body"></div>
    </section>
  </section>
</main>

<script>
/* Mission Control —— 先让用户做事，再让系统证明自己。
   数据全部来自真实 API；不伪造任何状态；术语严格区分
   VERIFIED（确定性校验）/ SEMANTIC REVIEW（模型复核）/ 不声称 RESULT CORRECT。 */
const API = location.port ? location.origin : "http://127.0.0.1:8848";
const $ = id => document.getElementById(id);
const esc = s => String(s ?? "").replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const fmtMs = ms => ms == null ? "—" : (ms >= 1000 ? (ms/1000).toFixed(1)+"s" : Math.round(ms)+"ms");
const fmtTime = ms => ms ? new Date(ms).toLocaleString("zh-CN", {hour12:false}) : "—";
const VIEWS = ["runs","skills","eval","system"];
const NAMES = {runs:"运行记录", skills:"技能库", eval:"评估与实验", system:"系统状态"};

/* ---------- 路由 ---------- */
function route(){
  const v = (location.hash.replace("#/","") || "mission");
  const cur = VIEWS.includes(v) ? v : "runs";
  VIEWS.forEach(x => $(`v-${x}`).classList.toggle("on", x === cur));
  $("nav").innerHTML = VIEWS.map(x =>
    `<a href="#/${x}" class="${x===cur?"on":""}">${NAMES[x]}</a>`).join("");
  if (cur === "runs") loadRuns();
  if (cur === "skills") loadSkills();
  if (cur === "eval") loadEval();
  if (cur === "system") loadSystem();
  if (cur === "mission") loadLatest();
}
window.addEventListener("hashchange", route);

/* ---------- 系统状态 ---------- */
let HEALTH = null;
async function loadHealth(){
  try {
    HEALTH = await (await fetch(API + "/api/health")).json();
    $("sys").innerHTML =
      `<span><span class="dot ${HEALTH.ok?"on":"off"}"></span>${HEALTH.ok?"online":"down"}</span>`
      + `<span>model ${esc(HEALTH.model||"—")}</span>`
      + `<span>${HEALTH.api_key_configured?"":"<span style='color:var(--warn)'>no key</span>"}</span>`
      + `<span>skills ${HEALTH.skills}</span>`
      + `<span>evolved ${HEALTH.evolved}</span>`;
  } catch { $("sys").innerHTML = '<span><span class="dot off"></span>offline</span>'; }
}

/* ---------- 示例任务 ---------- */
const EXAMPLES = [
  "分析一批不同剂量下的细胞存活率数据，做清洗、剂量-反应建模与可视化",
  "对两组实验数据做统计检验，报告效应量与置信区间",
  "分析一份含缺失值的表格数据，建立基线预测模型并做误差分析",
  "评估某化合物的成药性风险，给出筛选建议与依据",
];
$("ex").innerHTML = EXAMPLES.map(t => `<span class="ex">${esc(t.slice(0,26))}…</span>`).join("");
document.querySelectorAll(".ex").forEach((el, i) => el.onclick = () => { $("task").value = EXAMPLES[i]; });

/* ---------- 启动 Run ---------- */
async function startRun(){
  const task = $("task").value.trim();
  if (!task){ $("task").focus(); return; }
  const btn = $("run"); btn.disabled = true; const old = btn.textContent;
  btn.textContent = "Creating run…";
  try {
    const r = await fetch(API + "/api/runs", {
      method:"POST", headers:{"Content-Type":"application/json"},
      body: JSON.stringify({task, max_steps:+$("maxsteps").value||2,
                            max_cost_yuan:+$("maxcost").value||0.8,
                            max_seconds:+$("maxsec").value||240})
    });
    if (!r.ok){ const d = await r.json().catch(()=>({})); throw new Error(d.detail || r.status); }
    const d = await r.json();
    localStorage.setItem("last_run", d.run_id);
    location.href = `/run?id=${encodeURIComponent(d.run_id)}`;   // 立即跳 Live Run
  } catch (e) {
    alert("创建 Run 失败：" + (e.message || e));
    btn.disabled = false; btn.textContent = old;
  }
}

/* ---------- Latest Run（首屏关键：让用户看到系统在做事） ---------- */
async function loadLatest(){
  let runs = [];
  try { runs = (await (await fetch(API + "/api/runs?limit=1")).json()).runs || []; } catch {}
  const card = $("latest");
  if (!runs.length){ card.style.display = "none"; return; }
  const r = runs[0];
  let full = null;
  try { full = await (await fetch(API + `/api/runs/${encodeURIComponent(r.run_id)}`)).json(); } catch {}
  card.style.display = "block";
  $("latest-title").innerHTML = `Latest run <span class="badge st-${r.status}" style="margin-left:8px">${r.status}</span>`
    + (r.status === "INTERRUPTED" ? '<span style="font-size:11.5px;color:var(--warn);margin-left:10px">服务重启导致中断，请重新运行</span>' : "");
  $("latest-meta").innerHTML = `<a href="/run?id=${encodeURIComponent(r.run_id)}">打开 Live Run →</a>`;
  const steps = (full && full.steps) || [];
  const done = (full?.step_stats?.done) || 0, total = (full?.step_stats?.total) || 0;
  const pct = total ? Math.round(done/total*100) : 0;
  $("latest-body").innerHTML = `
    <div style="font-size:13px;margin-bottom:6px">${esc(r.task)}</div>
    <div style="font:11.5px var(--mono);color:var(--ink3)">
      ${esc(r.run_id)} · ${fmtTime(r.started_at_ms)} · 时长 ${fmtMs(r.duration_ms)} ·
      成本 ¥${Number(r.cost_yuan||0).toFixed(4)} · 步骤 ${done}/${total} · 产物 ${r.artifacts||0}
    </div>
    <div class="bar"><i style="width:${pct}%"></i></div>
    <div class="steps">${steps.map(s => `
      <div class="srow s-${s.status==="done"?"done":s.status}">
        <span class="sdot"></span>
        <span class="nm">S${s.idx+1} ${esc(s.action||"")}</span>
        <span>${esc(s.skill||"—")}</span>
        <span>${fmtMs(s.duration_ms)}${s.n_attempts>1?` ·×${s.n_attempts}`:""}</span>
      </div>`).join("") || '<div class="empty">步骤信息加载中…</div>'}</div>`;
}

/* ---------- Runs 列表 ---------- */
async function loadRuns(){
  let runs = [];
  try { runs = (await (await fetch(API + "/api/runs?limit=60")).json()).runs || []; } catch {}
  $("runs-meta").textContent = `${runs.length} runs · 同一任务共享 task fingerprint 但 run_id 不覆盖`;
  if (!runs.length){ $("runs-body").innerHTML = '<div class="empty">还没有 Run。到 Mission Control 启动一个。</div>'; return; }
  $("runs-body").innerHTML = `<table>
    <tr><th>Status</th><th>Task</th><th>Started</th><th>Duration</th><th>Steps</th><th>Artifacts</th><th>Cost</th><th>Fingerprint</th></tr>
    ${runs.map(r => `<tr onclick="location.href='/run?id=${encodeURIComponent(r.run_id)}'" style="cursor:pointer">
      <td><span class="badge st-${r.status}">${r.status}</span></td>
      <td style="color:var(--ink)">${esc((r.task||"").slice(0,60))}</td>
      <td>${fmtTime(r.started_at_ms)}</td>
      <td>${fmtMs(r.duration_ms)}</td>
      <td>${r.steps_done||0}/${r.steps||0}${r.steps_failed?` · <span style="color:var(--bad)">${r.steps_failed} failed</span>`:""}</td>
      <td>${r.artifacts||0}</td>
      <td>¥${Number(r.cost_yuan||0).toFixed(4)}</td>
      <td>${esc(r.task_fp||"")}</td>
    </tr>`).join("")}</table>`;
}

/* ---------- Skills ---------- */
let SKILLS = [];
async function loadSkills(){
  if (!SKILLS.length){
    try { SKILLS = (await (await fetch(API + "/api/skills")).json()).skills || []; } catch {}
  }
  const q = ($("q").value || "").toLowerCase();
  const rows = SKILLS.filter(s => !q || (s.name+s.domain+(s.capability||"")).toLowerCase().includes(q));
  $("skills-meta").textContent = `${rows.length} / ${SKILLS.length} skills · 来源 seed/evolved · 执行统计来自真实运行`;
  $("skills-body").innerHTML = rows.length ? `<table>
    <tr><th>Skill</th><th>Domain</th><th>Source</th><th>Exec</th><th>Reward</th><th>Quality</th></tr>
    ${rows.slice(0, 400).map(s => {
      const st = s.stats || {};
      const tot = st.exec_total || 0, ok = st.exec_ok || 0;
      return `<tr><td style="color:var(--ink)">${esc(s.name)}</td><td>${esc(s.domain)}</td>
        <td>${s.source === "seed" ? "seed" : `<span style="color:var(--warn)">evolved G${s.generation||1}</span>`}</td>
        <td>${tot ? `${ok}/${tot}${st.exec_fix?` · fix ${st.exec_fix}`:""}${st.exec_fail?` · <span style="color:var(--bad)">fail ${st.exec_fail}</span>`:""}` : "—"}</td>
        <td>${(s.stats?.mean_reward ?? 0).toFixed ? (s.stats.mean_reward||0).toFixed(3) : "—"}</td>
        <td style="color:var(--ink3)">${esc(Object.entries(s.quality||{}).map(([k,v])=>`${k.slice(0,4)}:${v}`).join(" "))}</td></tr>`;
    }).join("")}</table>` : '<div class="empty">无匹配技能</div>';
}
$("q").addEventListener("input", loadSkills);

/* ---------- Evaluations ---------- */
async function loadEval(){
  let d = null;
  try { d = await (await fetch(API + "/api/results")).json(); } catch {}
  const ho = d && (d.splits?.heldout || null);
  const dev = d && (d.splits?.dev || null);
  const block = (name, label, s) => {
    if (!s) return `<div class="empty">${label}：暂无数据</div>`;
    const e1 = s.exp1, e2 = s.exp2, e3 = s.exp3;
    return `<div style="margin-bottom:16px">
      <div style="font:600 12.5px inherit;margin-bottom:6px">${label}</div>
      <table>
        <tr><th>实验</th><th>指标</th><th>数值</th></tr>
        ${e1?`<tr><td>检索与编排</td><td>召回 / 编排完整度</td><td>${(e1.rows||[]).map(r=>`${r.mode}: ${r.recall}% / ${r.orchestration}%`).join(" · ")}</td></tr>`:""}
        ${e2?`<tr><td>执行质量</td><td>盲评均分</td><td>${(e2.rows||[]).map(r=>`${r.arm}: ${r.score}`).join(" · ")}</td></tr>`:""}
        ${e3?`<tr><td>选择策略</td><td>mean_reward</td><td>${Object.entries(e3.arms||{}).map(([k,v])=>`${k}: ${v.mean_reward}±${v.std??"—"}`).join(" · ")}</td></tr>
             <tr><td>统计结论</td><td>配对 bootstrap</td><td>${esc((e3.statistics||{}).verdict || "—")}</td></tr>`:""}
      </table></div>`;
  };
  $("eval-body").innerHTML =
    `<div class="empty" style="padding-bottom:10px">当前技能库规模已变（90+ 技能 / 162+ 边），实验数据为更早条件（51 技能 / 62 边）的产物 —— <b>尚未重跑</b>，文档已显式标注，不以此声称当前性能。</div>`
    + block("heldout", "HELD-OUT（冻结测试集 · 最终结论只引这里）", ho)
    + block("dev", "DEV（调参集）", dev)
    + `<div style="margin-top:14px;font-size:12px"><a href="/static/briefing.html" target="_blank">查看完整六幕复盘页（历史材料）</a> · <a href="/dashboard" target="_blank">完整面板</a> · <a href="/graph" target="_blank">技能拓扑</a></div>`;
}

