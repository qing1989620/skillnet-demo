      <tr><td><code>POST /api/runs/&#123;id&#125;/cancel</code></td><td>取消（检查点退出）</td></tr></table></div>`;
}

/* ---------- boot ---------- */
(async function(){ await loadHealth(); route(); setInterval(loadHealth, 15000); })();
</script>
