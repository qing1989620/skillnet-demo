# AOCI baselines exact raw bytes, so a checkout must be byte-identical on
# every platform: text always checks out LF, overriding any autocrlf rewrite
# (the Windows default) that would otherwise mark the whole tree stale.
# Binaries are auto-detected and left untouched.
* text=auto eol=lf
# Artifact manifests hash delivered bytes, including CSV line endings.
out/runs/**/artifacts/** -text whitespace=cr-at-eol
# Imported reference packages and signed evidence retain their upstream bytes.
seed/community/skills/** -text
out/runs/*.json -text
