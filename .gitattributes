# AOCI baselines exact raw bytes, so a checkout must be byte-identical on
# every platform: text always checks out LF, overriding any autocrlf rewrite
# (the Windows default) that would otherwise mark the whole tree stale.
# Binaries are auto-detected and left untouched.
* text=auto eol=lf
# Artifact manifests hash delivered bytes, including CSV line endings.
out/runs/**/artifacts/** -text whitespace=cr-at-eol
# Imported reference packages and signed evidence retain their upstream bytes.
seed/community/skills/** -text
out/runs/*.json -text
# These two evidence records are included in the raw-byte delivery manifest.
docs/evidence/candidates/simulated-order-monthly-review.json -text
out/outcome-evidence-smoke.json -text
out/reward-gates-smoke.json -text
docs/evidence/reward-gates-zero-gain.json -text
docs/evidence/candidates/reward-gates-business.json -text
out/research-ecosystem-smoke.json -text
docs/evidence/research-ecosystem-capsule.json -text
docs/evidence/candidates/research-reproducibility.json -text
out/skill-selection-smoke.json -text
docs/evidence/skill-selection-capsule.json -text
